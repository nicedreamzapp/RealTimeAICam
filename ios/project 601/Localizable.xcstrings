{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ didn't download. Connect to the internet, then tap the download button again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se descargó. Conéctate a internet y vuelve a tocar el botón de descarga."
          }
        }
      }
    },
    "%@ is ready, it works offline now." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está listo, ya funciona sin internet."
          }
        }
      }
    },
    "%@ → Eng" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
