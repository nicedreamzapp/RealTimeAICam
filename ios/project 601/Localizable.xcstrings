    },
    "%@, translated to %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, traducido al %@"
          }
        }
      }
    },
    "Adjust torch brightness between twenty five, fifty, seventy five, and one hundred percent." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la linterna al veinticinco, cincuenta, setenta y cinco o cien por ciento."
          }
        }
      }
    },
    "Copy text to the history for later use." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el texto al historial para usarlo después."
          }
        }
      }
    },
    "Download %@ once, then it works offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga %@ una vez y luego funciona sin internet"
          }
        }
      }
    },
    "Downloading %@, one time only." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargando %@, solo esta vez."
          }
        }
      }
    },
    "English OCR mode reads printed English text aloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lee en voz alta el texto impreso."
          }
        }
      }
    },
    "LiDAR Distance Assist is available only on LiDAR-equipped iPhone and iPad Pro models." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ayuda de distancia LiDAR solo está disponible en los iPhone y iPad Pro con LiDAR."
          }
        }
      }
    },
    "No %@ voice is installed on this phone. You can add one in the phone's settings, under Accessibility, Spoken Content, Voices." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono no tiene una voz en %@. Puedes agregar una en Ajustes del teléfono, en Accesibilidad, Contenido leído, Voces."
          }
        }
      }
    },
    "Object Detection mode detects and labels up to six hundred and one objects in real time." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detección de objetos reconoce y nombra hasta seiscientos un objetos en tiempo real."
          }
        }
      }
    },
    "Pinch the screen to zoom in or out." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca la pantalla para acercar o alejar."
          }
        }
      }
    },
    "Speak detected or translated text aloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee en voz alta el texto detectado o traducido."
          }
        }
      }
    },
    "Speech enabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voz activada"
          }
        }
      }
    },
    "Still downloading %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía descargando %@."
          }
        }
      }
    },
    "Tap 'Play Complete Audio Tutorial' any time to hear these instructions again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Reproducir el tutorial completo» cuando quieras para volver a escuchar estas instrucciones."
          }
        }
      }
    },
    "Tap the white ruler icon - it turns green when active - to enable LiDAR Distance Assist. This measures object distance, filters far-away objects, and stabilizes bounding boxes." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el ícono de la regla blanca (se pone verde cuando está activo) para activar la ayuda de distancia LiDAR. Mide la distancia a los objetos, ignora los que están lejos y estabiliza los recuadros."
          }
        }
      }
    },
    "The translator turns printed Spanish into English and reads it aloud. On iOS 18 and later it can translate other languages too, after a one-time download from Apple." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El traductor convierte texto impreso de otro idioma y lo lee en voz alta. En iOS 18 o posterior traduce más idiomas, después de una descarga única de Apple."
          }
        }
      }
    },
    "Toggle text overlay on or off." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra u oculta el texto sobre la imagen."
          }
        }
      }
    },
    "Toggle wide and ultra-wide lenses." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia entre el lente gran angular y el ultra gran angular."
          }
        }
      }
    },
    "Welcome to the real-time AI iOS Detection app. Thank you for choosing this voice!" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido a RealTime AI Cam. ¡Gracias por elegir esta voz!"
          }
        }
      }
    },
    "Welcome to the RealTime AI Camera." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido a RealTime AI Cam."
          }
        }
      }
    },
    "What's this? picks the most accurate model your phone can run by itself, and downloads it once on Wi-Fi. You can change it in Settings, under Models." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es esto? elige el modelo más preciso que tu teléfono puede usar por sí solo y lo descarga una vez por Wi-Fi. Puedes cambiarlo en Ajustes, en Modelos."
          }
        }
      }
    },
    "You can switch between front and back cameras." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar entre la cámara frontal y la trasera."
          }
        }
      }
    },
    "Your language is %@. Spoken results can be translated into %@ after a one-time download. You can change this in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu idioma es %@. Los resultados hablados se pueden traducir al %@ después de una descarga única. Puedes cambiarlo en Ajustes."
          }
        }
      }
    },
    "Your language: in Settings, pick the language you want to hear. The first time, tap Download once; after that it works offline. Read, Object Detection, Help Me Aim and What's this? then speak in your language. Buttons, menus and this guide are in Spanish when your phone or Your language is Spanish, and in English otherwise." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu idioma: en Ajustes, elige el idioma que quieres escuchar. La primera vez, toca Descargar una sola vez; después funciona sin internet. Leer, Detección de objetos, Ayúdame a apuntar y ¿Qué es esto? hablarán en tu idioma. Los botones, los menús y esta guía están en español cuando tu teléfono o Tu idioma están en español, y en inglés en los demás casos."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
