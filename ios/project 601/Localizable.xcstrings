            "value" : "Esperando para descargar."
          }
        }
      }
    },
    "Welcome to Live Cam. It's experimental, so double-check anything important. Hey there, how's it going?" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
