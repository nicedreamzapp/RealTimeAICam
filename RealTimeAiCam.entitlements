<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The narrator model is ~1.2 GB resident. On a 6 GB phone the default
	     per-app ceiling sits close enough to that, with a camera pipeline
	     already running, that the app gets killed mid-scan without this. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
